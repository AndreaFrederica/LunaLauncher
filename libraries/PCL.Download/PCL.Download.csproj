<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PCL.Download</RootNamespace>
    <AssemblyName>PCL.Download</AssemblyName>
    <Description>Standalone download module extracted from PCL-CE</Description>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- NativeAOT: publish as a native shared library (PCL.Download.dll / libPCL.Download.so / libPCL.Download.dylib) -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Downloader" Version="5.9.4" />
  </ItemGroup>

</Project>

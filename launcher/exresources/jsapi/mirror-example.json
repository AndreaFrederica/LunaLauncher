{
  "metadata": {
    "id": "example-mirror",
    "kind": "mirror",
    "displayName": "Example mirror",
    "version": "1.0.0",
    "description": "Declarative mirror rule example",
    "enabled": false,
    "priority": 50,
    "baseRule": false,
    "categories": ["assets"]
  },
  "rules": [
    {
      "match": {
        "hosts": ["resources.download.minecraft.net"]
      },
      "rewrite": {
        "candidates": [
          {
            "base": "https://mirror-a.example/assets",
            "probeUrl": "https://mirror-a.example/",
            "priority": 10,
            "category": "assets"
          },
          {
            "base": "https://mirror-b.example/assets",
            "probeUrl": "https://mirror-b.example/",
            "priority": 5,
            "category": "assets"
          }
        ]
      }
    }
  ]
}
